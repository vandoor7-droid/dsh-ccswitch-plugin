{
  "name": "dsh-ccswitch-plugin",
  "version": "0.1.0",
  "description": "Manage CC Switch provider profiles inside DeepSeek Harness: import, add, edit, switch, and configure per-model reasoning depth.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cc-switch",
    "ccswitch",
    "codex",
    "claude",
    "opencode",
    "provider-manager",
    "provider-import",
    "reasoning-effort"
  ],
  "author": {
    "name": "vandoor7-droid",
    "url": "https://github.com/vandoor7-droid"
  },
  "contributors": [
    {
      "name": "灰老大 (dsh-ccswitch-importer-plus)",
      "url": "https://github.com/2995288295"
    },
    {
      "name": "wtiaw (original dsh-ccswitch-importer)",
      "url": "https://github.com/wtiaw"
    }
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.js",
    "./catalog": "./dist/domain/catalog.mjs",
    "./validation": "./dist/domain/validation.mjs",
    "./settings": "./dist/domain/settings.mjs",
    "./package.json": "./package.json",
    "./ccs-provider": "./dist/domain/ccs-provider.mjs"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "test": "npm run build && node --test \"test/**/*.test.{js,mjs}\"",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dsh": {
    "compatibility": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vandoor7-droid/dsh-ccswitch-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/vandoor7-droid/dsh-ccswitch-plugin/issues"
  },
  "homepage": "https://github.com/vandoor7-droid/dsh-ccswitch-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lint": "6.8.5",
    "@codemirror/state": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.38.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.90.3",
    "@tanstack/react-virtual": "3.13.23",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "esbuild": "^0.25.0",
    "flexsearch": "0.8.212",
    "framer-motion": "12.23.25",
    "i18next": "25.5.2",
    "lucide-react": "0.542.0",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.65.0",
    "react-i18next": "16.0.0",
    "recharts": "3.5.1",
    "smol-toml": "1.4.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.12"
  }
}
